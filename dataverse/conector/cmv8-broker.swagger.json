      "post": {
        "operationId": "EmitirSasLote",
        "summary": "Emitir SAS de subida para un lote de adjuntos",
        "description": "Una SAS por adjunto y un único token de Storage del usuario. Un adjunto que falla no frena al resto: su error viaja en items[].",
