            "x-ms-summary": "Tabla"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uuid",
            "description": "Id del adjunto (GUID)",
            "x-ms-summary": "Id"
          },
          {
            "name": "X-Nombre-Archivo",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Nombre original del archivo (URL-encoded)",
            "x-ms-summary": "Nombre de archivo"
          },
          {
            "name": "X-Content-Type",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "MIME real del archivo (el cuerpo viaja como application/octet-stream)",
