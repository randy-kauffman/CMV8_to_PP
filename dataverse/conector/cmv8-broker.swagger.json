        "operationId": "IngestarArchivo",
        "summary": "Ingestar un archivo desde un flujo",
        "description": "Para Power Automate: el flujo creó la fila y manda el contenido como application/octet-stream, con el MIME real en X-Content-Type. Tope de 100 MB por acción. La identidad es la de la conexión.",
        "x-ms-visibility": "important",
        "consumes": [
          "application/octet-stream"
        ],
        "produces": [
          "application/json"
        ],
