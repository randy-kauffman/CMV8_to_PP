            }
          },
          "400": {
            "description": "Validación",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Sin identidad o acceso condicional (ver WWW-Authenticate)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Sin permiso sobre la fila o sin rol",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
