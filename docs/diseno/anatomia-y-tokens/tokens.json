{
  "meta": {
    "name": "Control de carga de archivos — tokens",
    "version": "0.1.0",
    "prefix": "--fu-",
    "variants": {
      "fluent": "Fluent nativo: idéntico a Fluent 2 / controles modernos de Power Apps y Dynamics 365.",
      "institucional": "Institucional sobrio: alto contraste, bordes finos, sin sombras, color solo para estado.",
      "moderno": "Moderno con tarjetas: cada archivo como tarjeta, más aire, progreso más visible."
    },
    "modes": [
      "light",
      "dark"
    ],
    "densities": [
      "compact",
      "comfortable"
    ],
    "valueShapes": "values.<variante> es un string (igual en ambos modos), {light,dark} (depende del modo) o {compact,comfortable} (depende de la densidad).",
    "maker": "Los tokens con \"maker\" se exponen como propiedad de entrada del control (manifest PCF). Si el maker deja la propiedad vacía se usa el valor de la variante. Los tokens con \"derived\" se recalculan a partir del token del maker cuando este cambia.",
    "contrast": "Todos los pares texto/fondo cumplen AA (4.5:1) en ambos modos: text y text-secondary sobre bg, surface y surface-alt; status-*-fg sobre status-*-bg y sobre surface; on-primary sobre primary. border-strong y focus cumplen 3:1 (no texto)."
  },
